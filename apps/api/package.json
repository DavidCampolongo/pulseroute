{
  "name": "@pulseroute/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:migrate:status": "prisma migrate status --config prisma.config.ts",
    "db:seed": "prisma db seed --config prisma.config.ts"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@pulseroute/db": "workspace:*",
    "@pulseroute/shared": "workspace:*",
    "argon2": "0.44.0",
    "dotenv": "17.4.2",
    "fastify": "5.10.0",
    "fastify-plugin": "6.0.0",
    "pg": "8.22.0",
    "prisma": "7.8.0",
    "tsx": "4.23.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "vitest": "4.1.10"
  }
}
