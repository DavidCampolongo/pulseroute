POSTGRES_DB=pulseroute
POSTGRES_USER=pulseroute
POSTGRES_PASSWORD=replace_with_local_development_password
POSTGRES_PORT=5432

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=debug

# Shared secret used to authenticate inbound webhook deliveries.
# Generate a strong secret for local/production environments; never commit it.
WEBHOOK_SECRET=

WEBHOOK_TOLERANCE_SECONDS=300

DATABASE_URL=postgresql://pulseroute:replace_with_local_development_password@localhost:5432/pulseroute

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Injects bounded worker scoring faults for retry/DLQ verification only.
FAULT_INJECT_SCORING=false

# Outbound assignment webhook delivery. Use a distinct secret from WEBHOOK_SECRET.
WEBHOOK_DELIVERY_URL=http://127.0.0.1:3100/webhooks
OUTBOUND_WEBHOOK_SECRET=
WEBHOOK_DELIVERY_TIMEOUT_MS=3000

# Local fake receiver controls. The timeout delay should exceed the worker timeout.
RECEIVER_PORT=3100
RECEIVER_MODE=success
RECEIVER_DELAY_MS=5000

# Local-only password used to hash seeded development users.
# Set a real value in .env; never commit it.
SEED_USER_PASSWORD=
